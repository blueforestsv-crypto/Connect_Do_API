APP_NAME=Connect Do API
APP_ENV=development
APP_DEBUG=true

POSTGRES_DB=connect_do
POSTGRES_USER=connect_do_user
POSTGRES_PASSWORD=change_this_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

DATABASE_URL=postgresql+asyncpg://connect_do_user:change_this_password@db:5432/connect_do
JWT_SECRET_KEY=replace_with_a_secure_random_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30