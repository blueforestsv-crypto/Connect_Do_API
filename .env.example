APP_NAME=Connect Do API
APP_ENV=development
APP_DEBUG=true

POSTGRES_DB=connect_do
POSTGRES_USER=connect_do_user
POSTGRES_PASSWORD=change_this_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

DATABASE_URL=postgresql+asyncpg://connect_do_user:change_this_password@db:5432/connect_do
JWT_SECRET_KEY=replace_with_a_secure_random_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
EMAIL_VERIFICATION_TOKEN_EXPIRE_MINUTES=15
EMAIL_VERIFICATION_RESEND_SECONDS=60
EMAIL_VERIFICATION_CODE_LENGTH=6
EMAIL_VERIFICATION_MAX_ATTEMPTS=5

# OAuth Google: Web Client ID(s) de Google Cloud, separados por coma.
GOOGLE_CLIENT_IDS=

# Correo saliente con Brevo (API HTTPS, recomendado en Render: el plan gratis
# bloquea los puertos SMTP). Si BREVO_API_KEY tiene valor, se usa Brevo.
# EMAIL_FROM_ADDRESS debe ser un remitente verificado en Brevo.
BREVO_API_KEY=

# Correo saliente (SMTP), alternativa si no se usa Brevo. Sin SMTP_HOST, en development el código solo
# aparece en el log y en la respuesta (debug_code).
# Ejemplos:
#   Gmail:  smtp.gmail.com, 587, tu-cuenta@gmail.com + contraseña de aplicación
#   Resend: smtp.resend.com, 465 (SMTP_USE_SSL=true), usuario "resend" + API key
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_SSL=false
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Connect Do

# Tests de integración: va en un archivo aparte, .env.test (ignorado por git):
#   TEST_DATABASE_URL=postgresql+asyncpg://usuario:clave@host/neondb?ssl=require
# Debe ser una base Postgres desechable (p. ej. una rama de Neon solo para
# tests). Nunca producción: los tests borran y recrean las tablas.
# Registrar consultas SQL (solo para depurar)
DB_ECHO=false
# Orígenes CORS permitidos, separados por coma ("*" = todos)
CORS_ORIGINS=*

# Push (Firebase Cloud Messaging): JSON completo de la cuenta de servicio en una línea.
# Vacío = sin push.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Correo de soporte que aparece en /privacidad.
SUPPORT_EMAIL=
